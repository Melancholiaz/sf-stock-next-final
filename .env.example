# ลิงก์เชื่อมต่อ Postgres (จาก Neon / Supabase) — ต้องตั้งใน Vercel > Settings > Environment Variables ด้วย
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# (ไม่บังคับ) ชื่อที่จะขึ้นในประวัติการแก้ไข และสิทธิ์ของทุกคน: admin หรือ staff
DEFAULT_NICKNAME=ผู้ใช้
DEFAULT_ROLE=admin
